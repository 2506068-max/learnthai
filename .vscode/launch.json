{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Mali's Thai Garden (Local Server)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Local Web Server"
        },
        {
            "name": "Launch Mali's Thai Garden (Direct File)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/fairy_thai_academy.html"
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
