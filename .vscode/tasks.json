{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Local Web Server (Port 3000)",
            "type": "shell",
            "command": "python3 server.py",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Mali's Thai Garden Server running.*"
                }
            }
        }
    ]
}
